{
  "max_bytes": 10485760,
  "fetch_allow_http": false,
  "outlets": [
    {
      "name": "my-chat",
      "type": "webhook",
      "url": "https://chat.example.com/inbox",
      "token_env": "MY_CHAT_TOKEN",
      "header": "Authorization",
      "mode": "json"
    },
    {
      "name": "phone",
      "type": "telegram",
      "chat_id": "123456789",
      "token_env": "SEND_TELEGRAM_BOT_TOKEN"
    },
    {
      "name": "server",
      "type": "discord",
      "url_env": "SEND_DISCORD_WEBHOOK_URL"
    },
    {
      "name": "push",
      "type": "ntfy",
      "url": "https://ntfy.sh/pick-a-long-random-topic-name"
    }
  ]
}
